# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=root
DB_PASSWORD=
DB_NAME=oxelia51

# Server
SERVER_PORT=8080
LISTEN_ADDR=127.0.0.1:8080
JWT_SECRET=change-me-in-production

# Redis
REDIS_ADDR=localhost:6379

# CORS（可选）：Access-Control-Allow-Origin 唯一允许的跨域来源，默认生产站点
# CORS_ORIGIN=https://oxelia51.com

# 管理后台统计（可选）
# ADMIN_STATS_ALLOWED_IP=118.25.138.177   # TENCENT_HEALTH_URL 允许的主机 IP（默认生产服务器；loopback 始终允许）
# GATEWAY_STATUS_URL=http://127.0.0.1:9090/api/proxy/status   # 本机 proxy-gateway 状态接口（/gateway-stats 的代理目标）

# Admin (optional; if empty, first start generates password to Desktop)
ADMIN_INITIAL_PASSWORD=

# JWT TTL (optional)
# ACCESS_TOKEN_TTL=168h
# REFRESH_TOKEN_TTL=720h

# API 网关上游（loopback，不暴露公网；覆盖 tools.internal_api_base）
TOOL_API_BASE_DORMGUARD=http://127.0.0.1:8000
TOOL_API_BASE_SECRETSTORE=http://127.0.0.1:8006
# GATEWAY_UPSTREAM_TIMEOUT=30s
# GATEWAY_MAX_BODY_BYTES=10485760

# SmartKB 智能知识库
# SMARTKB_EMBEDDING_API_KEY=        # 必填，LLM API Key
# SMARTKB_EMBEDDING_API_BASE=        # 必填，LLM API 地址
# SMARTKB_EMBEDDING_MODEL=text-embedding-3-small   # Embedding 模型
# SMARTKB_CHAT_MODEL=gpt-4o-mini                    # 对话模型
# SMARTKB_CODE_ROOT=D:\07_Projects\code             # 代码扫描根目录
