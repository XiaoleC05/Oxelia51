# =============================================
#  Oxelia51 v3.0 — Langfuse 环境变量（腾讯云）
#  复制此文件为 .env 后填入实际值
#  生成命令见下方
# =============================================

# ---- PostgreSQL ----
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=postgres

# ---- ClickHouse ----
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=CHANGEME

# ---- Redis ----
REDIS_AUTH=CHANGEME

# ---- MinIO (对象存储) ----
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=CHANGEME

# ---- Langfuse 核心密钥 ----
# 生成: openssl rand -hex 32
SALT=CHANGEME
ENCRYPTION_KEY=CHANGEME
NEXTAUTH_SECRET=CHANGEME
NEXTAUTH_URL=http://localhost:3000

# ---- 后台管理（必填，否则容器启动失败） ----
# 超级管理员邮箱：唯一可执行写操作的账户，须为已在云平台注册的邮箱
OXELIA_SUPER_ADMIN_EMAIL=postmaster@oxelia51.com
# Go 后端运维凭证：web 服务端用它换 JWT 转发管理请求（不下发浏览器）
OXELIA51_ADMIN_ACCOUNT=CHANGEME
OXELIA51_ADMIN_PASSWORD=CHANGEME
# 管理员邮箱名单（选填，逗号分隔；空 = 除超级管理员外无人是管理员）
# OXELIA51_ADMIN_EMAILS=

# ---- 可选：首次启动自动创建 ----
# LANGFUSE_INIT_ORG_NAME=Oxelia51
# LANGFUSE_INIT_PROJECT_NAME=default
# LANGFUSE_INIT_USER_EMAIL=admin@oxelia51.com
# LANGFUSE_INIT_USER_NAME=admin
# LANGFUSE_INIT_USER_PASSWORD=CHANGEME

# ---- 可选：邮件（SMTP）- 暂不配置 ----
# EMAIL_FROM_ADDRESS=
# SMTP_CONNECTION_URL=
