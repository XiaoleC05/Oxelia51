[Unit]
Description=Oxelia51 SSH Tunnel (Aliyun 127.0.0.1:3000 -> Tencent Cloud web:3000)
After=network.target

[Service]
Type=simple
User=root
# 本地 3000 → 腾讯云 127.0.0.1:3000（langfuse-web），密钥见 /root/.ssh/tencent_cloud
ExecStart=/usr/bin/ssh -N -L 127.0.0.1:3000:127.0.0.1:3000 \
    -i /root/.ssh/tencent_cloud \
    -o StrictHostKeyChecking=no \
    -o ServerAliveInterval=30 \
    -o ServerAliveCountMax=3 \
    -o ExitOnForwardFailure=yes \
    root@118.25.138.177
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
