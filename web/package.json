  "scripts": {
    "build": "INLINE_RUNTIME_CHUNK=false dotenv -e ../.env -- next build",
    "build:check": "NEXT_DIST_DIR=.next-check INLINE_RUNTIME_CHUNK=false dotenv -e ../.env -- next build",
    "typecheck": "dotenv -e ../.env -- tsgo -p tsconfig.json --noEmit --skipLibCheck --incremental --tsBuildInfoFile .tsbuildinfo",
    "dev": "dotenv -e ../.env -- next dev",
    "dev:http": "dotenv -e ../.env -- next dev --experimental-https --experimental-https-key ./localhost+1-key.pem --experimental-https-cert ./localhost+1.pem",
    "lint": "dotenv -e ../.env -- eslint . --cache --cache-location .next/cache/eslint/ --max-warnings 0 --concurrency 2",
    "lint:fix": "dotenv -e ../.env -- eslint . --cache --cache-location .next/cache/eslint/ --fix --concurrency 2",
    "analyze": "dotenv -e ../.env -- next experimental-analyze",
    "clean": "rm -rf node_modules",
    "start": "dotenv -e ../.env -- sh -c 'NEXT_MANUAL_SIG_HANDLE=true next start'",
    "test": "vitest run --project server --project server-isolated --project server-unit --project in-source",
    "test:in-source": "vitest run --project in-source",
    "test-client": "vitest run --project client",
    "test:watch": "vitest --project client --project server --project server-isolated --project server-unit --project in-source",
    "test-storybook": "vitest run --project storybook",
    "test:e2e": "dotenv -e ../.env.test -e ../.env -- playwright test --reporter=line",
    "test:e2e:server": "vitest run --project e2e-server",
    "build-trace": "dotenv -e ../.env -- next internal trace .next/trace-turbopack",
    "storybook": "dotenv -e ../.env -- storybook dev -p 6006",
    "build-storybook": "dotenv -e ../.env -- storybook build"
  },
